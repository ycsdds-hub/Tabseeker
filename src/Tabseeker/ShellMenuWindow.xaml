<Window x:Class="Tabseeker.ShellMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="탐색기 우클릭 메뉴 정리" Width="720" Height="680" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Background="White">
    <DockPanel Margin="16,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="탐색기 우클릭 메뉴 정리"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0">
                파일·폴더를 오른쪽 클릭했을 때(‘더 많은 옵션 표시’ 메뉴) 늘어서 있는 프로그램 항목들을
                <Run FontWeight="SemiBold" Foreground="#111827">‘앱 메뉴 모음 ▸’</Run> 하나로 묶습니다. 마우스를 올리면 트리처럼 펼쳐져서 고를 수 있습니다.
                현재 Windows 사용자에게만 적용되고(관리자 권한 불필요), <Run FontWeight="SemiBold" Foreground="#111827">‘원래대로 되돌리기’</Run>로 언제든 그대로 돌아옵니다.
            </TextBlock>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="UndoBtn" Content="원래대로 되돌리기" Padding="12,4" Margin="0,0,8,0" Click="Undo_Click"/>
                    <Button x:Name="ApplyBtn" Content="적용" Padding="18,4" Margin="0,0,8,0" Click="Apply_Click" IsDefault="True"/>
                    <Button Content="닫기" Padding="14,4" IsCancel="True" Click="Close_Click"/>
                </StackPanel>
                <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Margin="0,4,0,2" Text="① ‘앱 메뉴 모음 ▸’ 안으로 옮길 항목"/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="체크한 항목은 우클릭 메뉴 맨 위에서 사라지고 ‘앱 메뉴 모음’ 하위 메뉴 안에 그대로 들어갑니다. 기능은 똑같이 동작합니다."/>
                <ItemsControl x:Name="GroupList"/>

                <TextBlock FontWeight="SemiBold" Margin="0,16,0,2" Text="② 숨길 항목 (확장 프로그램 방식 — 묶을 수 없음)"/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="7-Zip·알집 같은 항목은 프로그램이 메뉴를 직접 그려서 Windows 구조상 하위 메뉴로 옮길 수 없습니다. 안 쓰는 것만 골라 숨길 수 있고(우클릭 메뉴에서 사라짐), 되돌리기로 다시 나타납니다. 기본은 아무것도 숨기지 않습니다."/>
                <ItemsControl x:Name="HideList"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
