<Window x:Class="Tabseeker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabseeker" Width="1200" Height="760" MinWidth="640" MinHeight="400"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Background="{StaticResource Chrome}"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <DataTemplate x:Key="TabHeader">
            <Border x:Name="Card" Tag="{Binding}" Height="32" MinWidth="90" MaxWidth="230" Margin="0,4,2,0" Padding="9,0,4,0"
                    CornerRadius="7,7,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0"
                    ToolTip="{Binding ToolTip}" AllowDrop="True" Cursor="Arrow"
                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown" PreviewMouseMove="Tab_PreviewMouseMove"
                    MouseUp="Tab_MouseUp" DragOver="Tab_DragOver" Drop="Tab_Drop" ContextMenuOpening="Tab_ContextMenuOpening">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ChromeDark}"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Width="20" Height="20" FontSize="8" Tag="{Binding}"
                            Content="&#xE8BB;" ToolTip="탭 닫기 (Ctrl+W)" Click="TabClose_Click" Margin="4,0,0,0"/>
                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="White"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="1,1,1,0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- tab strip + global search -->
        <Grid Grid.Row="0" Margin="6,2,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="Strip" Background="Transparent" MouseLeftButtonDown="Strip_MouseLeftButtonDown">
                <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="TabsHost" ItemTemplate="{StaticResource TabHeader}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="NewTabBtn" Style="{StaticResource ToolButton}" Content="&#xE710;" ToolTip="새 탭 (Ctrl+T) · 빈 곳 더블클릭"
                                Click="NewTab_Click" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,3,0,0">
                <Grid Width="340">
                    <TextBox x:Name="SearchBox" Style="{StaticResource HintBox}" Padding="22,0,0,0"
                             Tag="      모든 드라이브에서 검색 (Ctrl+E · 어디서나 Ctrl+Alt+F)"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="MenuBtn" Style="{StaticResource ToolButton}" Content="&#xE713;" ToolTip="설정" Click="MenuBtn_Click" Margin="4,0,0,0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="HiddenItem" Header="숨김 파일 표시" IsCheckable="True" Click="Hidden_Click"/>
                            <MenuItem Header="색인 다시 만들기" Click="Reindex_Click"/>
                            <Separator/>
                            <MenuItem Header="메모 모아 보기 (memo:)" Click="MemoList_Click"/>
                            <MenuItem x:Name="MemoEmptyItem" Header="메모 없는 이름에도 호버 말풍선" IsCheckable="True" Click="MemoEmpty_Click"/>
                            <Separator/>
                            <MenuItem Header="탐색기 우클릭 메뉴 정리…" Click="ShellMenu_Click"/>
                            <Separator/>
                            <MenuItem Header="단축키 / 검색 문법" Click="Help_Click"/>
                            <MenuItem Header="Tabseeker 정보" Click="About_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- nav + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="210" MinWidth="120" MaxWidth="480"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#F7F8FA" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Nav" Margin="6,6,6,12" AllowDrop="True" Background="Transparent" Drop="Nav_Drop" DragOver="Nav_DragOver"/>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Line}" ShowsPreview="False"/>
            <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="White">
                <ContentControl x:Name="Host" Focusable="False"/>
            </Border>
        </Grid>

        <!-- index status -->
        <Border Grid.Row="2" Background="{StaticResource ChromeDark}" Padding="10,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12"
                           Text="Ctrl+T 새 탭 · Ctrl+W 닫기 · Ctrl+Shift+T 닫은 탭 · 가운데 클릭 = 새 탭 · 빈 곳 더블클릭 = 위로"/>
                <TextBlock x:Name="IndexStatus" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
