<Window x:Class="Tabseeker.MemoBubble"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        Width="300" Height="170" MinWidth="200" MinHeight="110"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- [left arrow][card][right arrow]: the arrow always points at the hovered name -->
    <Grid Margin="0,4,6,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Path x:Name="LeftArrow" Grid.Column="0" Data="M 10,0 L 0,8 L 10,16 Z" Fill="#FFF8D9" Stroke="#E3C766" StrokeThickness="1"
              VerticalAlignment="Top" Margin="0,14,-1,0" Panel.ZIndex="2"/>
        <Path x:Name="RightArrow" Grid.Column="2" Data="M 0,0 L 10,8 L 0,16 Z" Fill="#FFF8D9" Stroke="#E3C766" StrokeThickness="1"
              VerticalAlignment="Top" Margin="-1,14,0,0" Panel.ZIndex="2" Visibility="Collapsed"/>

        <Border x:Name="Card" Grid.Column="1" Background="#FFF8D9" BorderBrush="#E3C766" BorderThickness="1" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
            </Border.Effect>
            <DockPanel Margin="10,7,4,4">
                <!-- header -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Width="22" Height="22" FontSize="9"
                            Content="&#xE8BB;" ToolTip="닫기 (Esc)" Click="Close_Click"/>
                    <Button x:Name="DeleteBtn" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Width="22" Height="22" FontSize="11"
                            Content="&#xE74D;" ToolTip="메모 지우기" Click="Delete_Click"/>
                    <Image x:Name="ItemIcon" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ItemName" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#5B4A0E"/>
                </DockPanel>
                <!-- footer: status + resize grip -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,2,0,0">
                    <Thumb x:Name="Grip" DockPanel.Dock="Right" Width="14" Height="14" Cursor="SizeNWSE" DragDelta="Grip_DragDelta"
                           DragCompleted="Grip_DragCompleted" ToolTip="끌어서 크기 조절">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Path Data="M 12,2 L 2,12 M 12,6 L 6,12 M 12,10 L 10,12" Stroke="#B89A3A" StrokeThickness="1.2"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <TextBlock x:Name="Status" FontSize="11" Foreground="#9A8541" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <!-- memo text -->
                <Grid Margin="0,0,6,0">
                    <TextBlock x:Name="Hint" Text="이 파일이 무엇인지 메모하세요… (자동 저장)" Foreground="#B5A468" Margin="3,1,0,0"
                               IsHitTestVisible="False" TextWrapping="Wrap"/>
                    <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" Background="Transparent"
                             BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Auto" Foreground="#2B2408"
                             TextChanged="Editor_TextChanged"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
